+                        source.sendFailure(net.minecraft.network.chat.Component.literal(e.getMessage()));
+                    }
+                } else {
+                    showLocateResult(source, resourceOrTag, sourcePos, closestWithType.get().swap(), "commands.locate.poi.success", false, stopwatch.elapsed());
+                }
+            });
+            return 0;
+        }
+        // Purpur end - async locator (DivineMC)
         BlockPos sourcePos = BlockPos.containing(source.getPosition());
         ServerLevel serverLevel = source.getLevel();
         Stopwatch stopwatch = Stopwatch.createStarted(Util.TICKER);
