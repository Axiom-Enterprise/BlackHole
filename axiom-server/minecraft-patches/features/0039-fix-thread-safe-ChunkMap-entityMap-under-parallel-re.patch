From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Carlo=20Maria=20Card=C3=AD?=
 <112445885+MathsAnalysis@users.noreply.github.com>
Date: Sat, 6 Jun 2026 06:39:24 +0200
Subject: [PATCH] fix: thread-safe ChunkMap entityMap under parallel/regionized
 ticking


diff --git a/net/minecraft/server/level/ChunkMap.java b/net/minecraft/server/level/ChunkMap.java
index ce2140ca11d0644d7376a679827408906f8ddcfd..5a6f787d7dc0ca9a88e1a918ead6471947d0c0ec 100644
--- a/net/minecraft/server/level/ChunkMap.java
+++ b/net/minecraft/server/level/ChunkMap.java
@@ -996,9 +996,11 @@ public class ChunkMap extends SimpleRegionStorage implements ChunkHolder.PlayerP
     public void addEntity(final Entity entity) {
         org.spigotmc.AsyncCatcher.catchOp("entity track"); // Spigot
         // Paper start - ignore and warn about illegal addEntity calls instead of crashing server
-        if (!entity.valid || entity.level() != this.level || this.entityMap.containsKey(entity.getId())) {
+        final boolean alreadyTracked; // Leaf - guard containsKey against concurrent structural mutation (parallel/regionized ticking)
+        synchronized (this.entityMap) { alreadyTracked = this.entityMap.containsKey(entity.getId()); } // Leaf
+        if (!entity.valid || entity.level() != this.level || alreadyTracked) {
             LOGGER.error("Illegal ChunkMap::addEntity for world " + io.papermc.paper.util.MCUtil.getLevelName(this.level)
-                + ": " + entity  + (this.entityMap.containsKey(entity.getId()) ? " ALREADY CONTAINED (This would have crashed your server)" : ""), new Throwable());
+                + ": " + entity  + (alreadyTracked ? " ALREADY CONTAINED (This would have crashed your server)" : ""), new Throwable());
             return;
         }
         // Paper end - ignore and warn about illegal addEntity calls instead of crashing server
@@ -1009,28 +1011,39 @@ public class ChunkMap extends SimpleRegionStorage implements ChunkHolder.PlayerP
             range = org.spigotmc.TrackingRange.getEntityTrackingRange(entity, range); // Spigot
             if (range != 0) {
                 int updateInterval = type.updateInterval();
-                if (this.entityMap.containsKey(entity.getId())) {
-                    throw (IllegalStateException)Util.pauseInIde(new IllegalStateException("Entity is already tracked!"));
-                }
+                // Leaf start - serialize structural entityMap access; under parallel/regionized world ticking
+                // addEntity/removeEntity run from multiple tick threads on the same level, and a concurrent
+                // put/remove corrupts the Int2ObjectOpenHashMap (rehash AIOOBE). Do the existence check,
+                // insert and tracker bind atomically, and snapshot the broadcast targets under the same lock
+                // so the heavy updatePlayer work (events/packets) runs lock-free below.
+                final ChunkMap.TrackedEntity trackedEntity;
+                final ChunkMap.TrackedEntity[] broadcastTargets;
+                synchronized (this.entityMap) {
+                    if (this.entityMap.containsKey(entity.getId())) {
+                        throw (IllegalStateException)Util.pauseInIde(new IllegalStateException("Entity is already tracked!"));
+                    }
 
-                ChunkMap.TrackedEntity trackedEntity = new ChunkMap.TrackedEntity(entity, range, updateInterval, type.trackDeltas());
-                this.entityMap.put(entity.getId(), trackedEntity);
-                // Paper start - optimise entity tracker
-                if (((ca.spottedleaf.moonrise.patches.entity_tracker.EntityTrackerEntity)entity).moonrise$getTrackedEntity() != null) {
-                    throw new IllegalStateException("Entity is already tracked");
+                    trackedEntity = new ChunkMap.TrackedEntity(entity, range, updateInterval, type.trackDeltas());
+                    this.entityMap.put(entity.getId(), trackedEntity);
+                    // Paper start - optimise entity tracker
+                    if (((ca.spottedleaf.moonrise.patches.entity_tracker.EntityTrackerEntity)entity).moonrise$getTrackedEntity() != null) {
+                        throw new IllegalStateException("Entity is already tracked");
+                    }
+                    ((ca.spottedleaf.moonrise.patches.entity_tracker.EntityTrackerEntity)entity).moonrise$setTrackedEntity(trackedEntity);
+                    // Paper end - optimise entity tracker
+                    broadcastTargets = entity instanceof ServerPlayer ? this.entityMap.values().toArray(new ChunkMap.TrackedEntity[0]) : null;
                 }
-                ((ca.spottedleaf.moonrise.patches.entity_tracker.EntityTrackerEntity)entity).moonrise$setTrackedEntity(trackedEntity);
-                // Paper end - optimise entity tracker
                 trackedEntity.updatePlayers(this.level.players());
                 if (entity instanceof ServerPlayer player) {
                     this.updatePlayerStatus(player, true);
 
-                    for (ChunkMap.TrackedEntity e : this.entityMap.values()) {
+                    for (ChunkMap.TrackedEntity e : broadcastTargets) {
                         if (e.entity != player) {
                             e.updatePlayer(player);
                         }
                     }
                 }
+                // Leaf end
             }
         }
     }
@@ -1040,12 +1053,17 @@ public class ChunkMap extends SimpleRegionStorage implements ChunkHolder.PlayerP
         if (entity instanceof ServerPlayer player) {
             this.updatePlayerStatus(player, false);
 
-            for (ChunkMap.TrackedEntity trackedEntity : this.entityMap.values()) {
+            // Leaf start - snapshot under lock, run removePlayer lock-free (parallel/regionized ticking)
+            final ChunkMap.TrackedEntity[] snapshot;
+            synchronized (this.entityMap) { snapshot = this.entityMap.values().toArray(new ChunkMap.TrackedEntity[0]); }
+            for (ChunkMap.TrackedEntity trackedEntity : snapshot) {
                 trackedEntity.removePlayer(player);
             }
+            // Leaf end
         }
 
-        ChunkMap.TrackedEntity trackedEntity = this.entityMap.remove(entity.getId());
+        final ChunkMap.TrackedEntity trackedEntity; // Leaf - atomic remove
+        synchronized (this.entityMap) { trackedEntity = this.entityMap.remove(entity.getId()); } // Leaf
         if (trackedEntity != null) {
             trackedEntity.broadcastRemoved();
         }
@@ -1119,7 +1137,7 @@ public class ChunkMap extends SimpleRegionStorage implements ChunkHolder.PlayerP
     }
 
     public void sendToTrackingPlayers(final Entity entity, final Packet<? super ClientGamePacketListener> packet) {
-        ChunkMap.TrackedEntity trackedEntity = this.entityMap.get(entity.getId());
+        final ChunkMap.TrackedEntity trackedEntity; synchronized (this.entityMap) { trackedEntity = this.entityMap.get(entity.getId()); } // Leaf - guarded read
         if (trackedEntity != null) {
             trackedEntity.sendToTrackingPlayers(packet);
         }
@@ -1128,26 +1146,27 @@ public class ChunkMap extends SimpleRegionStorage implements ChunkHolder.PlayerP
     public void sendToTrackingPlayersFiltered(
         final Entity entity, final Packet<? super ClientGamePacketListener> packet, final Predicate<ServerPlayer> targetPredicate
     ) {
-        ChunkMap.TrackedEntity trackedEntity = this.entityMap.get(entity.getId());
+        final ChunkMap.TrackedEntity trackedEntity; synchronized (this.entityMap) { trackedEntity = this.entityMap.get(entity.getId()); } // Leaf - guarded read
         if (trackedEntity != null) {
             trackedEntity.sendToTrackingPlayersFiltered(packet, targetPredicate);
         }
     }
 
     protected void sendToTrackingPlayersAndSelf(final Entity entity, final Packet<? super ClientGamePacketListener> packet) {
-        ChunkMap.TrackedEntity trackedEntity = this.entityMap.get(entity.getId());
+        final ChunkMap.TrackedEntity trackedEntity; synchronized (this.entityMap) { trackedEntity = this.entityMap.get(entity.getId()); } // Leaf - guarded read
         if (trackedEntity != null) {
             trackedEntity.sendToTrackingPlayersAndSelf(packet);
         }
     }
 
     public boolean isTrackedByAnyPlayer(final Entity entity) {
-        ChunkMap.TrackedEntity trackedEntity = this.entityMap.get(entity.getId());
+        final ChunkMap.TrackedEntity trackedEntity; synchronized (this.entityMap) { trackedEntity = this.entityMap.get(entity.getId()); } // Leaf - guarded read
         return trackedEntity != null && !trackedEntity.seenBy.isEmpty();
     }
 
     public void forEachEntityTrackedBy(final ServerPlayer player, final Consumer<Entity> consumer) {
-        for (ChunkMap.TrackedEntity entity : this.entityMap.values()) {
+        final ChunkMap.TrackedEntity[] snapshot; synchronized (this.entityMap) { snapshot = this.entityMap.values().toArray(new ChunkMap.TrackedEntity[0]); } // Leaf - guarded snapshot
+        for (ChunkMap.TrackedEntity entity : snapshot) {
             if (entity.seenBy.contains(player.connection)) {
                 consumer.accept(entity.entity);
             }
