diff --git a/net/minecraft/network/protocol/game/ClientboundLevelChunkPacketData.java b/net/minecraft/network/protocol/game/ClientboundLevelChunkPacketData.java
index d98fc6d62634ebeb3ba07dcaa51b4024105ddd2f..5531a0d017fa29d104ead3909d4bdce42b26d92f 100644
--- a/net/minecraft/network/protocol/game/ClientboundLevelChunkPacketData.java
+++ b/net/minecraft/network/protocol/game/ClientboundLevelChunkPacketData.java
@@ -121,6 +121,38 @@ public class ClientboundLevelChunkPacketData {
     }
     // Purpur end - async chunk sending (DivineMC)
 
+    // Leaf start - independent anti-xray: serialize from pre-obfuscated section copies (ores already
+    // rewritten to fake on the tick thread). The copies are immutable snapshots, so unlike the live
+    // sections they cannot mutate mid-serialization - the size is exact and no re-extract loop is needed,
+    // even on the async chunk-send thread. Block entities and heightmaps are precomputed by the caller on
+    // the tick thread to avoid touching the live chunk off-thread.
+    public ClientboundLevelChunkPacketData(final LevelChunkSection[] obfuscatedSections, final BlockEntity[] blockEntities, final Map<Heightmap.Types, long[]> heightmaps) {
+        this.heightmaps = heightmaps;
+        if (Thread.currentThread() instanceof org.bxteam.divinemc.async.AsyncChunkSend.AsyncChunkSendThread) {
+            final int size = calculateChunkSize(obfuscatedSections);
+            final ByteBuf buffer = Unpooled.buffer(size);
+            extractChunkData(new FriendlyByteBuf(buffer), obfuscatedSections);
+            this.buffer = it.unimi.dsi.fastutil.bytes.ByteArrays.setLength(buffer.array(), buffer.writerIndex());
+        } else {
+            this.buffer = new byte[calculateChunkSize(obfuscatedSections)];
+            extractChunkData(new FriendlyByteBuf(this.getWriteBuffer()), obfuscatedSections);
+        }
+
+        this.blockEntitiesData = Lists.newArrayList();
+        int totalTileEntities = 0;
+        for (final BlockEntity blockEntity : blockEntities) {
+            if (++totalTileEntities > BLOCK_ENTITY_LIMIT) {
+                final net.minecraft.network.protocol.Packet<ClientGamePacketListener> packet = blockEntity.getUpdatePacket();
+                if (packet != null) {
+                    this.extraPackets.add(packet);
+                    continue;
+                }
+            }
+            this.blockEntitiesData.add(ClientboundLevelChunkPacketData.BlockEntityInfo.create(blockEntity));
+        }
+    }
+    // Leaf end
+
     public ClientboundLevelChunkPacketData(final RegistryFriendlyByteBuf input, final int x, final int z) {
         this.heightmaps = HEIGHTMAPS_STREAM_CODEC.decode(input);
         int size = input.readVarInt();
@@ -150,6 +182,26 @@ public class ClientboundLevelChunkPacketData {
         return total;
     }
 
+    // Leaf start - independent anti-xray: size/serialize an explicit (obfuscated) section array
+    private static int calculateChunkSize(final LevelChunkSection[] sections) {
+        int total = 0;
+        for (final LevelChunkSection section : sections) {
+            total += section.getSerializedSize();
+        }
+        return total;
+    }
+
+    public static void extractChunkData(final FriendlyByteBuf buffer, final LevelChunkSection[] sections) {
+        for (final LevelChunkSection section : sections) {
+            section.write(buffer); // no ChunkPacketInfo: ores were already rewritten in the copies
+        }
+        if (Thread.currentThread() instanceof org.bxteam.divinemc.async.AsyncChunkSend.AsyncChunkSendThread) return;
+        if (buffer.writerIndex() != buffer.capacity()) {
+            throw new IllegalStateException("Didn't fill chunk buffer: expected " + buffer.capacity() + " bytes, got " + buffer.writerIndex());
+        }
+    }
+    // Leaf end
+
     private ByteBuf getWriteBuffer() {
         ByteBuf buffer = Unpooled.wrappedBuffer(this.buffer);
         buffer.writerIndex(0);
