-    public ClientboundLevelChunkWithLightPacket(final LevelChunk chunk, final LevelLightEngine lightEngine, final @Nullable BitSet skyLight, final @Nullable BitSet blockLight, final net.minecraft.world.level.block.entity.BlockEntity[] blockEntities, final java.util.Map<net.minecraft.world.level.levelgen.Heightmap.Types, long[]> heightmaps, final net.minecraft.world.level.chunk.LevelChunkSection[] obfuscatedSections) {
+    public ClientboundLevelChunkWithLightPacket(final LevelChunk chunk, final LevelLightEngine lightEngine, final @Nullable BitSet skyLight, final @Nullable BitSet blockLight, final net.minecraft.world.level.block.entity.BlockEntity[] blockEntities, final java.util.Map<net.minecraft.world.level.levelgen.Heightmap.Types, long[]> heightmaps, final byte[] obfuscatedBuffer) {
         final ChunkPos chunkPos = chunk.getPos();
         this.x = chunkPos.x();
         this.z = chunkPos.z();
-        this.chunkData = new ClientboundLevelChunkPacketData(obfuscatedSections, blockEntities, heightmaps);
+        this.chunkData = new ClientboundLevelChunkPacketData(obfuscatedBuffer, blockEntities, heightmaps);
         this.lightData = new ClientboundLightUpdatePacketData(chunkPos, lightEngine, skyLight, blockLight);
     }
     // Leaf end
