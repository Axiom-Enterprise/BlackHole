From: =?UTF-8?q?Carlo=20Maria=20Card=C3=AD?=
 <112445885+MathsAnalysis@users.noreply.github.com>
Date: Sat, 6 Jun 2026 08:23:12 +0200
Subject: [PATCH] fix: serialize dragonParts under parallel/regionized ticking


diff --git a/net/minecraft/server/level/ServerLevel.java b/net/minecraft/server/level/ServerLevel.java
index 5659b0797a2e9bd8f91f7993a615e5859fe9e3ac..19e6e76702d99ddb5b01d765bb7e7eaacaccd7b4 100644
--- a/net/minecraft/server/level/ServerLevel.java
+++ b/net/minecraft/server/level/ServerLevel.java
@@ -2382,12 +2382,19 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
     @Deprecated
     public @Nullable Entity getEntityOrPart(final int id) {
         Entity entity = this.getEntities().get(id);
-        return entity != null ? entity : this.dragonParts.get(id);
+        if (entity != null) {
+            return entity;
+        }
+        // Leaf - dragonParts is a level-global Int2ObjectOpenHashMap mutated from entity tracking-start/end
+        // callbacks, which run from multiple region threads under parallel/regionized ticking; serialize on
+        // the map monitor (concurrent put/remove corrupts the table -> rehash AIOOBE).
+        synchronized (this.dragonParts) { return this.dragonParts.get(id); } // Leaf
     }
 
     @Override
     public Collection<EnderDragonPart> dragonParts() {
-        return this.dragonParts.values();
+        // Leaf - snapshot under the monitor so callers can iterate without racing a concurrent put/remove
+        synchronized (this.dragonParts) { return new java.util.ArrayList<>(this.dragonParts.values()); } // Leaf
     }
 
     public @Nullable BlockPos findNearestMapStructure(
@@ -3022,8 +3029,10 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
             }
 
             if (entity instanceof EnderDragon dragon) {
-                for (EnderDragonPart subEntity : dragon.getSubEntities()) {
-                    ServerLevel.this.dragonParts.put(subEntity.getId(), subEntity);
+                synchronized (ServerLevel.this.dragonParts) { // Leaf - serialize level-global map (parallel/regionized ticking)
+                    for (EnderDragonPart subEntity : dragon.getSubEntities()) {
+                        ServerLevel.this.dragonParts.put(subEntity.getId(), subEntity);
+                    }
                 }
             }
 
@@ -3093,8 +3102,10 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
             }
 
             if (entity instanceof EnderDragon dragon) {
-                for (EnderDragonPart subEntity : dragon.getSubEntities()) {
-                    ServerLevel.this.dragonParts.remove(subEntity.getId());
+                synchronized (ServerLevel.this.dragonParts) { // Leaf - serialize level-global map (parallel/regionized ticking)
+                    for (EnderDragonPart subEntity : dragon.getSubEntities()) {
+                        ServerLevel.this.dragonParts.remove(subEntity.getId());
+                    }
                 }
             }
 
