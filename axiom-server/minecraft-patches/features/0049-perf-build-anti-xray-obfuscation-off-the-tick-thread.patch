         // Purpur start - async chunk sending (DivineMC)
         if (org.bxteam.divinemc.config.DivineConfig.AsyncCategory.asyncChunkSendingEnabled) {
             var blockEntities = chunk.blockEntities.values().toArray(new net.minecraft.world.level.block.entity.BlockEntity[0]);
@@ -110,15 +108,19 @@ public class PlayerChunkSender {
                 }
             }
 
-            if (antiXrayBuffer != null) {
-                org.bxteam.divinemc.async.AsyncChunkSend.POOL.execute(() -> connection.send(new ClientboundLevelChunkWithLightPacket(chunk, level.getLightEngine(), null, null, blockEntities, heightmaps, antiXrayBuffer))); // DivineMC - independent anti-xray
-            } else {
-                org.bxteam.divinemc.async.AsyncChunkSend.POOL.execute(() -> connection.send(new ClientboundLevelChunkWithLightPacket(chunk, level.getLightEngine(), null, null, shouldModify, blockEntities, heightmaps)));
-            }
+            org.bxteam.divinemc.async.AsyncChunkSend.POOL.execute(() -> {
+                final byte[] antiXrayBuffer = org.bxteam.divinemc.antixray.RaytraceAntiXrayEngine.obfuscatedBuffer(chunk); // off-tick build
