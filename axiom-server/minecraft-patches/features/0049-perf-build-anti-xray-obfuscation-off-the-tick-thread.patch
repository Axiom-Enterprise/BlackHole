Date: Sat, 6 Jun 2026 09:46:39 +0200
Subject: [PATCH] perf: build anti-xray obfuscation off the tick thread

Obfuscation (ore scan + section copy + serialize) ran synchronously on
the tick thread per chunk send, stalling the server during the join and
leaving players on an endless 'loading terrain' / void. Move the build
onto the async chunk-send pool (matching the normal send path) and make
serialize tolerant of concurrent section edits via a size retry loop.

- PlayerChunkSender: call obfuscatedBuffer inside the async POOL task;
  sync path still builds on the tick thread
- ClientboundLevelChunkPacketData.serialize: Paper-style retry loop,
  drop the strict fill assertion (sections may be shared live ones)

diff --git a/net/minecraft/network/protocol/game/ClientboundLevelChunkPacketData.java b/net/minecraft/network/protocol/game/ClientboundLevelChunkPacketData.java
index 9f77a5f14a2f3171ae121dd6c7c4bef261274d3e..0f614c6182bb9e867d247254e40398690528f59b 100644
--- a/net/minecraft/network/protocol/game/ClientboundLevelChunkPacketData.java
+++ b/net/minecraft/network/protocol/game/ClientboundLevelChunkPacketData.java
@@ -143,13 +143,22 @@ public class ClientboundLevelChunkPacketData {
         }
     }
 
-    /** Serialize an explicit (obfuscated) section array into a chunk-data buffer for caching/reuse. */
+    /**
+     * Serialize an explicit (obfuscated) section array into a chunk-data buffer for caching/reuse.
+     * Mirrors the async-send retry loop: the section array mixes immutable ore copies with shared live
+     * (non-ore) sections, so a concurrent edit can change the serialized size mid-write; recompute and
+     * rewrite until the size is stable. Safe to run off the tick thread (anti-xray builds on the async pool).
+     */
     public static byte[] serialize(final LevelChunkSection[] sections) {
-        final byte[] buffer = new byte[calculateChunkSize(sections)];
-        final ByteBuf buf = Unpooled.wrappedBuffer(buffer);
-        buf.writerIndex(0);
+        int size = calculateChunkSize(sections);
+        final ByteBuf buf = Unpooled.buffer(size);
         extractChunkData(new FriendlyByteBuf(buf), sections);
-        return buffer;
+        while (size != buf.writerIndex()) {
+            buf.writerIndex(0);
+            size = calculateChunkSize(sections);
+            extractChunkData(new FriendlyByteBuf(buf), sections);
+        }
+        return it.unimi.dsi.fastutil.bytes.ByteArrays.setLength(buf.array(), buf.writerIndex());
     }
     // Leaf end
 
@@ -192,12 +201,10 @@ public class ClientboundLevelChunkPacketData {
     }
 
     public static void extractChunkData(final FriendlyByteBuf buffer, final LevelChunkSection[] sections) {
+        // No ChunkPacketInfo: ores were already rewritten in the copies. No fill assertion here - the
+        // size invariant is enforced by serialize()'s retry loop (sections may be shared live ones).
         for (final LevelChunkSection section : sections) {
-            section.write(buffer); // no ChunkPacketInfo: ores were already rewritten in the copies
-        }
-        if (Thread.currentThread() instanceof org.bxteam.divinemc.async.AsyncChunkSend.AsyncChunkSendThread) return;
-        if (buffer.writerIndex() != buffer.capacity()) {
-            throw new IllegalStateException("Didn't fill chunk buffer: expected " + buffer.capacity() + " bytes, got " + buffer.writerIndex());
+            section.write(buffer);
         }
     }
     // Leaf end
