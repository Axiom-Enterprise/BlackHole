         } else {
+            final byte[] antiXrayBuffer = org.bxteam.divinemc.antixray.RaytraceAntiXrayEngine.obfuscatedBuffer(chunk); // sync path: build on tick
             if (antiXrayBuffer != null) {
-                // DivineMC start - independent anti-xray sync path: precompute block entities + heightmaps on
-                // this (tick) thread, then serialize from the obfuscated copies.
+                // DivineMC - independent anti-xray sync path: precompute block entities + heightmaps on the
+                // tick thread, then serialize from the obfuscated copies.
                 var blockEntities = chunk.blockEntities.values().toArray(new net.minecraft.world.level.block.entity.BlockEntity[0]);
                 java.util.Map<net.minecraft.world.level.levelgen.Heightmap.Types, long[]> heightmaps = new java.util.HashMap<>();
                 for (var entry : chunk.getHeightmaps()) {
@@ -127,11 +129,11 @@ public class PlayerChunkSender {
                     }
                 }
                 connection.send(new ClientboundLevelChunkWithLightPacket(chunk, level.getLightEngine(), null, null, blockEntities, heightmaps, antiXrayBuffer));
