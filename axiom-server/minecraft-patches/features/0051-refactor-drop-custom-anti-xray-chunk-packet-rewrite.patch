+++ b/net/minecraft/network/protocol/game/ClientboundLevelChunkPacketData.java
@@ -121,47 +121,6 @@ public class ClientboundLevelChunkPacketData {
     }
     // Purpur end - async chunk sending (DivineMC)
 
-    // Leaf start - independent anti-xray: build from a pre-serialized (and cached, viewer-shared)
-    // obfuscated section buffer. The buffer is immutable and read-only on write(), so the same array is
-    // safely shared across all connections. Block entities and heightmaps are precomputed by the caller on
-    // the tick thread to avoid touching the live chunk off-thread.
-    public ClientboundLevelChunkPacketData(final byte[] obfuscatedBuffer, final BlockEntity[] blockEntities, final Map<Heightmap.Types, long[]> heightmaps) {
-        this.heightmaps = heightmaps;
-        this.buffer = obfuscatedBuffer;
-
-        this.blockEntitiesData = Lists.newArrayList();
-        int totalTileEntities = 0;
-        for (final BlockEntity blockEntity : blockEntities) {
-            if (++totalTileEntities > BLOCK_ENTITY_LIMIT) {
-                final net.minecraft.network.protocol.Packet<ClientGamePacketListener> packet = blockEntity.getUpdatePacket();
-                if (packet != null) {
-                    this.extraPackets.add(packet);
-                    continue;
-                }
-            }
-            this.blockEntitiesData.add(ClientboundLevelChunkPacketData.BlockEntityInfo.create(blockEntity));
-        }
-    }
-
-    /**
-     * Serialize an explicit (obfuscated) section array into a chunk-data buffer for caching/reuse.
-     * Mirrors the async-send retry loop: the section array mixes immutable ore copies with shared live
-     * (non-ore) sections, so a concurrent edit can change the serialized size mid-write; recompute and
-     * rewrite until the size is stable. Safe to run off the tick thread (anti-xray builds on the async pool).
-     */
-    public static byte[] serialize(final LevelChunkSection[] sections) {
-        int size = calculateChunkSize(sections);
-        final ByteBuf buf = Unpooled.buffer(size);
-        extractChunkData(new FriendlyByteBuf(buf), sections);
-        while (size != buf.writerIndex()) {
-            buf.writerIndex(0);
-            size = calculateChunkSize(sections);
-            extractChunkData(new FriendlyByteBuf(buf), sections);
-        }
-        return it.unimi.dsi.fastutil.bytes.ByteArrays.setLength(buf.array(), buf.writerIndex());
-    }
-    // Leaf end
-
     public ClientboundLevelChunkPacketData(final RegistryFriendlyByteBuf input, final int x, final int z) {
         this.heightmaps = HEIGHTMAPS_STREAM_CODEC.decode(input);
         int size = input.readVarInt();
@@ -191,24 +150,6 @@ public class ClientboundLevelChunkPacketData {
         return total;
     }
 
-    // Leaf start - independent anti-xray: size/serialize an explicit (obfuscated) section array
-    private static int calculateChunkSize(final LevelChunkSection[] sections) {
-        int total = 0;
-        for (final LevelChunkSection section : sections) {
-            total += section.getSerializedSize();
-        }
-        return total;
-    }
-
-    public static void extractChunkData(final FriendlyByteBuf buffer, final LevelChunkSection[] sections) {
-        // No ChunkPacketInfo: ores were already rewritten in the copies. No fill assertion here - the
-        // size invariant is enforced by serialize()'s retry loop (sections may be shared live ones).
-        for (final LevelChunkSection section : sections) {
-            section.write(buffer);
-        }
-    }
-    // Leaf end
-
     private ByteBuf getWriteBuffer() {
         ByteBuf buffer = Unpooled.wrappedBuffer(this.buffer);
         buffer.writerIndex(0);
