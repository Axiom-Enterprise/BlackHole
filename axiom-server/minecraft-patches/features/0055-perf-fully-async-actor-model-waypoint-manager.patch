+    /** Clone each player's sent-chunk set on the current (tick) thread, where that read is safe. */
+    private static Map<ServerPlayer, LongOpenHashSet> capture(final Iterable<ServerPlayer> snapPlayers) {
+        final Map<ServerPlayer, LongOpenHashSet> map = new IdentityHashMap<>();
+        for (final ServerPlayer p : snapPlayers) {
+            try {
+                final ca.spottedleaf.moonrise.patches.chunk_system.player.RegionizedPlayerChunkLoader.PlayerChunkLoaderData loader =
+                    ((ca.spottedleaf.moonrise.patches.chunk_system.player.ChunkSystemServerPlayer) p).moonrise$getChunkLoader();
+                if (loader != null) {
+                    map.put(p, loader.getSentChunksRaw().clone());
+                }
+            } catch (final Throwable ignored) {
+                // Defensive: a rare lifecycle call may run off the owning world thread under parallel world
+                // ticking, making this clone race the chunk system. Skip the player rather than crash; the
+                // worst case is its waypoints are treated as not chunk-visible for this one batch.
+            }
+        }
+        return map;
+    }
+
+    /** Run {@code task} on the worker with {@code snapshot} published for isChunkVisible. */
+    private static void submit(final Map<ServerPlayer, LongOpenHashSet> snapshot, final Runnable task) {
+        WAYPOINT_EXECUTOR.execute(() -> {
+            SENT_SNAPSHOT.set(snapshot);
+            try {
+                task.run();
+            } catch (final Throwable t) {
+                LOGGER.error("Error in async waypoint task", t);
+            } finally {
+                SENT_SNAPSHOT.remove();
+            }
+        });
+    }
+
+    /** Run {@code task} on the worker with no visibility snapshot (disconnect-only tasks). */
+    private static void submit(final Runnable task) {
+        submit(Collections.emptyMap(), task);
+    }
