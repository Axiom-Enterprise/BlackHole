@@ -33,7 +33,7 @@ public final class ChunkLoadTask extends ChunkProgressionTask {
     private static final Logger LOGGER = LoggerFactory.getLogger(ChunkLoadTask.class);
 
     private final NewChunkHolder chunkHolder;
-    private final ChunkDataLoadTask loadTask;
+    private final com.infernalsuite.asp.level.moonrise.CommonLoadTask loadTask; // ASP
 
     private volatile boolean cancelled;
     private NewChunkHolder.GenericDataLoadTaskCallback entityLoadTask;
@@ -45,11 +45,24 @@ public final class ChunkLoadTask extends ChunkProgressionTask {
                          final NewChunkHolder chunkHolder, final Priority priority) {
         super(scheduler, world, chunkX, chunkZ);
         this.chunkHolder = chunkHolder;
-        this.loadTask = new ChunkDataLoadTask(scheduler, world, chunkX, chunkZ, priority);
-        this.loadTask.addCallback((final GenericDataLoadTask.TaskResult<ChunkAccess, Throwable> result) -> {
+        // ASP start - route slime worlds through in-memory chunk loader
+        if (world instanceof com.infernalsuite.asp.level.SlimeLevelInstance) {
+            this.loadTask = new com.infernalsuite.asp.level.moonrise.ChunkDataLoadTask(
+                this, scheduler, world, chunkX, chunkZ, priority,
+                (final GenericDataLoadTask.TaskResult<ChunkAccess, Throwable> result) -> {
+                    ChunkLoadTask.this.loadResult = result;
+                    ChunkLoadTask.this.tryCompleteLoad();
+                }
+            );
+        } else {
+        // ASP end
+        final ChunkDataLoadTask chunkDataLoadTask = new ChunkDataLoadTask(scheduler, world, chunkX, chunkZ, priority);
+        this.loadTask = chunkDataLoadTask;
+        chunkDataLoadTask.addCallback((final GenericDataLoadTask.TaskResult<ChunkAccess, Throwable> result) -> {
             ChunkLoadTask.this.loadResult = result; // must be before getAndDecrement
             ChunkLoadTask.this.tryCompleteLoad();
         });
+        } // ASP
     }
 
     private void tryCompleteLoad() {
@@ -276,7 +289,7 @@ public final class ChunkLoadTask extends ChunkProgressionTask {
 
     private static record ReadChunk(ProtoChunk protoChunk, SerializableChunkData chunkData) {}
 
