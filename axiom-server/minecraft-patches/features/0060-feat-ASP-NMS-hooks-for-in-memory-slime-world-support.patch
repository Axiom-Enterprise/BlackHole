+++ b/ca/spottedleaf/moonrise/patches/chunk_system/scheduling/NewChunkHolder.java
@@ -897,6 +897,11 @@ public final class NewChunkHolder {
             }
 
             if (chunk instanceof LevelChunk levelChunk) {
+                // ASP start - let slime world handle its own unload
+                if (this.world instanceof com.infernalsuite.asp.level.SlimeLevelInstance slimeLevel) {
+                    slimeLevel.getSlimeInstance().onChunkWillUnload(levelChunk);
+                }
+                // ASP end
                 this.world.unload(levelChunk);
             }
 
@@ -906,7 +911,11 @@ public final class NewChunkHolder {
         // unload entity data
         if (entityChunk != null) {
             final Completable<CompoundTag>[] entityWrite = new Completable[1];
+            // ASP start - skip entity save for slime worlds
+            if (!(this.world instanceof com.infernalsuite.asp.level.SlimeLevelInstance)) {
             this.saveEntities(entityChunk, true, entityWrite);
+            }
+            // ASP end
 
             if (entityChunk.unload()) {
                 final ReentrantAreaLock.Node schedulingLock = this.scheduler.schedulingLockArea.lock(this.chunkX, this.chunkZ);
@@ -1706,6 +1715,11 @@ public final class NewChunkHolder {
         boolean canSaveChunk = !forceNoSaveChunk && (chunk != null && ((shutdown || chunk instanceof LevelChunk) && chunk.isUnsaved()));
         boolean canSavePOI = !forceNoSaveChunk && (poi != null && poi.isDirty());
         boolean canSaveEntities = entities != null;
+        // ASP start - slime worlds manage their own entity persistence
+        if (this.world instanceof com.infernalsuite.asp.level.SlimeLevelInstance) {
+            canSaveEntities = false;
+        }
+        // ASP end
 
         if (canSaveChunk) {
             canSaveChunk = this.saveChunk(chunk, false, null);
diff --git a/ca/spottedleaf/moonrise/patches/chunk_system/scheduling/task/ChunkLoadTask.java b/ca/spottedleaf/moonrise/patches/chunk_system/scheduling/task/ChunkLoadTask.java
