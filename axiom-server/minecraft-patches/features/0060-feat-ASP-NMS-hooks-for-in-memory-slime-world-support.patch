+    public final EntityList entities = new EntityList(); // ASP
 
     // Leaf start - parallel world ticking: serialize this slice's non-thread-safe entity storage
     // (BasicEntityList / EntityList / entitiesBy{Type,Class}) against concurrent region tick threads.
diff --git a/ca/spottedleaf/moonrise/patches/chunk_system/scheduling/ChunkHolderManager.java b/ca/spottedleaf/moonrise/patches/chunk_system/scheduling/ChunkHolderManager.java
