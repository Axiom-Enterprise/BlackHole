     public void save(final Player player) {
+        // Purpur start - async playerdata save (Leaf)
+        // Default entry point stays synchronous. Used by player-quit and server-shutdown saves,
+        // which must be flushed to disk before the connection drops / the process exits.
+        this.save(player, false);
